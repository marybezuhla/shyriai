; Godot project for Shyriai. Opened with Godot 4.7.2 (see .github/workflows/build.yml).

config_version=5

[application]

config/name="Ширяй"
config/name_localized={
"en": "Shyriai",
"uk": "Ширяй"
}
config/description="Drone and ground robot piloting trainer"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icons/icon_256.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.164706, 0.113725, 0.231373, 1)
boot_splash/show_image=false

[autoload]

Pal="*res://scripts/palette.gd"
Prefs="*res://scripts/prefs.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=390
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.uk.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.164706, 0.113725, 0.231373, 1)
textures/vram_compression/import_etc2_astc=true
